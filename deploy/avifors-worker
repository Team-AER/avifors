#!/usr/bin/env python3
"""Install root-owned. Adjust only this fixed allowlist, never accept arbitrary units."""
import subprocess
import sys

UNITS = {"text": "avifors-text.service", "image": "avifors-image.service", "stt": "avifors-stt.service"}
if len(sys.argv) != 3 or sys.argv[1] not in {"start", "stop", "verify"} or sys.argv[2] not in UNITS:
    raise SystemExit(2)
action, unit = sys.argv[1], UNITS[sys.argv[2]]
if action == "verify":
    state = subprocess.check_output(["systemctl", "show", "--property=ActiveState", "--value", unit], text=True).strip()
    raise SystemExit(0 if state in {"inactive", "failed"} else 1)
subprocess.run(["systemctl", action, unit], check=True)
