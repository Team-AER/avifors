# Copy to deploy/docker/.env on the host (compose reads it automatically; it is not committed).
# Never put API keys here: they belong in /etc/avifors/secrets.env (mode 0600).

# Host paths (production defaults).
#AVIFORS_ETC=/etc/avifors
#AVIFORS_DATA=/var/lib/avifors

# Tag for the locally built avifors, avifors-decision, avifors-stt-qwen, avifors-stt-omni and
# avifors-image images.
#AVIFORS_TAG=local

# Text worker (vendor image, not rebuilt). Pin by digest; confirm on the host with
#   docker image inspect vllm/vllm-openai:v0.26.0 --format '{{index .RepoDigests 0}}'
# Docker Hub index digest of v0.26.0 on 2026-10-02:
AVIFORS_VLLM_IMAGE=vllm/vllm-openai:v0.26.0@sha256:ffb2d59b1c059a5bd8d781320c9f5189de8293693b7d95da54befddaa54abf52

# The old avifors-text container's model and engine flags (its command, without the image's
# entrypoint), as one shell-quoted string. Copy them from
#   docker inspect avifors-text --format '{{json .Config.Entrypoint}} {{json .Config.Cmd}}'
# (the entrypoint must be the image default) and keep the engine on port 8000 inside the
# container. Placeholder, not production:
AVIFORS_TEXT_ARGS="--model YOUR/MODEL --port 8000 --max-model-len 131072 --gpu-memory-utilization 0.90 --kv-cache-dtype fp8"

# The old container's named volumes and where it mounts them:
#   docker inspect avifors-text --format '{{json .Mounts}}'
#AVIFORS_VLLM_CACHE_VOLUME=vllm-cache
#AVIFORS_VLLM_CACHE_TARGET=/root/.cache/vllm
#AVIFORS_GEMMA_CONFIG_VOLUME=gemma-config
#AVIFORS_GEMMA_CONFIG_TARGET=/config
