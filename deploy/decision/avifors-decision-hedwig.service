[Unit]
Description=Avifors on-demand System One decision worker (aer-laya-hedwig)
After=network-online.target

[Service]
Type=simple
User=avifors
Group=avifors
WorkingDirectory=/var/lib/avifors
Environment=HOME=/var/lib/avifors
Environment=OMP_NUM_THREADS=3
Environment=TOKENIZERS_PARALLELISM=false
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
# CPU lane: never touch the managed GPU.
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=/opt/avifors-decision-venv/bin/python -m avifors.decision_worker --checkpoint /var/lib/avifors/decision/aer-laya-hedwig --threads 3 --port 18005 --card aer-laya-hedwig
Restart=no
TimeoutStopSec=10
KillMode=control-group
MemoryMax=4G
MemorySwapMax=0
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/avifors
UMask=0077
# No Install section: the broker alone owns lifecycle and boot decisions.
